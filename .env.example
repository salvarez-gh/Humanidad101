# PostHog product analytics
# Copy this file to .env and set the values. Vite exposes only variables
# with the VITE_ prefix to the client. Set the same values in the build
# environment so the deployed site also captures events.
VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com
